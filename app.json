{
  "expo": {
    "name": "مستشفى التعاون",
    "slug": "altaawon-hospital",
    "version": "1.0.0",
    "description": "تطبيق مستشفى التعاون التخصصي لحجز وإدارة المواعيد والخدمات الطبية",
    "orientation": "portrait",
    "icon": "./assets/icons/application_icon.png",
    "scheme": "altaawon",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "ar": "ar"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altaawaonhospital.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "مستشفى التعاون",
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لرفع صورة سند الدفع",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق معرض الصور لاختيار صورة سند الدفع",
        "NSPhotoLibraryAddUsageDescription": "يستخدم التطبيق معرض الصور لحفظ الصور",
        "NSUserNotificationsUsageDescription": "يستخدم التطبيق الإشعارات لإعلامك بمواعيدك وتحديثات الحجوزات"
      }
    },
    "android": {
      "package": "com.altaawaonhospital.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#02a972",
        "foregroundImage": "./assets/icons/application_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/waittng.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#02a972",
          "dark": {
            "image": "./assets/images/waittng.png",
            "imageWidth": 400,
            "resizeMode": "contain",
            "backgroundColor": "#02a972"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم التطبيق معرض الصور لاختيار صورة سند الدفع",
          "cameraPermission": "يستخدم التطبيق الكاميرا لرفع صورة سند الدفع"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/application_icon.png",
          "color": "#10b981",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a18bc87-8e32-48ef-98c2-f2e596cf3961"
      }
    },
    "owner": "abdulrahman1001"
  }
}

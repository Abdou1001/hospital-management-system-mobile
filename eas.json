{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.103:5175/api",
        "PLATFORM_FEE": "500"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hospital-management-system-backend-production-4e9c.up.railway.app/api",
        "EXPO_PUBLIC_STORAGE_URL": "https://hospital-management-system-backend-production-4e9c.up.railway.app",
        "PLATFORM_FEE": "500"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hospital-management-system-backend-production-4e9c.up.railway.app/api",
        "EXPO_PUBLIC_STORAGE_URL": "https://hospital-management-system-backend-production-4e9c.up.railway.app",
        "PLATFORM_FEE": "500"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "your@apple.id",
        "ascAppId": "YOUR_APP_STORE_APP_ID",
        "appleTeamId": "YOUR_TEAM_ID"
      }
    }
  }
}
